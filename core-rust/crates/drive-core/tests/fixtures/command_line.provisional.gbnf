# PROVISIONAL COPY of the GBNF in docs v1.2 03 §4.1 (verbatim). The canonical file is
# schema/slm/override.gbnf (owned by Hydrogenくん); it did not exist on the base branch
# CREME/chore-integrate-team-worktrees @ 1cb4e5a.
# TODO(gbnf): delete this copy once schema/slm/override.gbnf lands; tests/command_line.rs
#             already prefers the canonical file when it is present.
root     ::= cmd "\n"
cmd      ::= override | "CXL" | "WHY" | "BMK" | "YES" | "NO" | "NOOP"
override ::= "OVR" ( rc nr? mg? dt? jp? | nr mg? dt? jp? | mg dt? jp? | dt jp? | jp )
rc ::= " rc=" level
nr ::= " nr=" level
mg ::= " mg=" level
dt ::= " dt=" ("T" | "S")
jp ::= " jp=" ("last" | "next")
level ::= "L" | "N" | "H"
