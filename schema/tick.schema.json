{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slm-map.invalid/schema/tick.schema.json",
  "title": "dc_tick v2 (TickInput / Event / TickOutput)",
  "description": "dc_tick v2 contract. Canonical: docs v1.2 ADR-0008 (decisions 2/3/6) and 03 §3.1. Mirrors contracts::tick (core-rust). *_mono_ms are JSON integers; enum values snake_case; reroute_result / search_cancelled are abolished (search_finished is the only terminal event); search_finished.outcome has no timeout. The root accepts either a TickInput or a TickOutput; validate against #/$defs/<Name> for a specific type. TODO(schema-v1): token / utterance_id / reason / tier value types, the tag names `cmd` / `ui` / `voice` and the VoiceCmd token encoding are provisional; VoiceCmd / UiCmd hold only what docs v1.2 names (05 §5, 04 §4.3, 05 §3.2, ADR-0007).",
  "anyOf": [
    {
      "$ref": "#/$defs/TickInput"
    },
    {
      "$ref": "#/$defs/TickOutput"
    }
  ],
  "$defs": {
    "TickInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "now_mono_ms"
      ],
      "properties": {
        "now_mono_ms": {
          "$ref": "common.schema.json#/$defs/MonoMs"
        },
        "fix": {
          "$ref": "#/$defs/Fix"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Event"
          },
          "description": "In at_mono_ms ascending order (Rust clamps and logs clock_regression otherwise; it does not re-sort)."
        }
      }
    },
    "Fix": {
      "description": "GNSS fix, integers only (docs 04 §3.1, ADR-0008). Kotlin rounds the Location doubles once: lat_e7/lon_e7 = Math.round(deg * 1e7); acc_cm = accuracy in cm; bearing_cdeg = Math.round(deg * 100) % 36000 (0..35999, 359.996° -> 0); speed_cm_s = speed in cm/s.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at_mono_ms",
        "lat_e7",
        "lon_e7",
        "acc_cm"
      ],
      "properties": {
        "at_mono_ms": {
          "$ref": "common.schema.json#/$defs/MonoMs"
        },
        "lat_e7": {
          "type": "integer",
          "minimum": -900000000,
          "maximum": 900000000
        },
        "lon_e7": {
          "type": "integer",
          "minimum": -1800000000,
          "maximum": 1800000000
        },
        "acc_cm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "bearing_cdeg": {
          "type": "integer",
          "minimum": 0,
          "maximum": 35999
        },
        "speed_cm_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "Event": {
      "description": "Event = {at_mono_ms} & one kind-specific variant, tagged by `kind`.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_mono_ms",
            "kind",
            "token"
          ],
          "properties": {
            "at_mono_ms": {
              "$ref": "common.schema.json#/$defs/MonoMs"
            },
            "kind": {
              "const": "tts_started"
            },
            "token": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_mono_ms",
            "kind",
            "token"
          ],
          "properties": {
            "at_mono_ms": {
              "$ref": "common.schema.json#/$defs/MonoMs"
            },
            "kind": {
              "const": "tts_done"
            },
            "token": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_mono_ms",
            "kind",
            "token"
          ],
          "properties": {
            "at_mono_ms": {
              "$ref": "common.schema.json#/$defs/MonoMs"
            },
            "kind": {
              "const": "tts_stopped"
            },
            "token": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_mono_ms",
            "kind",
            "utterance_id"
          ],
          "properties": {
            "at_mono_ms": {
              "$ref": "common.schema.json#/$defs/MonoMs"
            },
            "kind": {
              "const": "asr_started"
            },
            "utterance_id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_mono_ms",
            "kind",
            "utterance_id",
            "text_class"
          ],
          "properties": {
            "at_mono_ms": {
              "$ref": "common.schema.json#/$defs/MonoMs"
            },
            "kind": {
              "const": "asr_result"
            },
            "utterance_id": {
              "type": "string"
            },
            "text_class": {
              "enum": [
                "dict",
                "natural"
              ]
            },
            "dict_norm": {
              "type": "string"
            }
          },
          "description": "Dictionary matching is done in Rust; raw utterance text never crosses (only text_class + normalized dict string)."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_mono_ms",
            "kind",
            "utterance_id"
          ],
          "properties": {
            "at_mono_ms": {
              "$ref": "common.schema.json#/$defs/MonoMs"
            },
            "kind": {
              "const": "asr_failed"
            },
            "utterance_id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_mono_ms",
            "kind",
            "utterance_id",
            "status",
            "confirm_screen_id"
          ],
          "properties": {
            "at_mono_ms": {
              "$ref": "common.schema.json#/$defs/MonoMs"
            },
            "kind": {
              "const": "override_ready"
            },
            "utterance_id": {
              "type": "string"
            },
            "override_id": {
              "type": "string"
            },
            "status": {
              "enum": [
                "ok",
                "timeout",
                "error"
              ]
            },
            "confirm_screen_id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_mono_ms",
            "kind",
            "target_id",
            "action"
          ],
          "properties": {
            "at_mono_ms": {
              "$ref": "common.schema.json#/$defs/MonoMs"
            },
            "kind": {
              "const": "user_tap"
            },
            "target_id": {
              "type": "string"
            },
            "action": {
              "enum": [
                "confirm",
                "avoid",
                "undo"
              ]
            }
          },
          "description": "Only taps come from Kotlin as consent. target_id = AvoidOffer.offer_id | override_id | confirm_screen_id (ADR-0008, 03 §4.2)."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_mono_ms",
            "kind",
            "status"
          ],
          "properties": {
            "at_mono_ms": {
              "$ref": "common.schema.json#/$defs/MonoMs"
            },
            "kind": {
              "const": "thermal"
            },
            "status": {
              "$ref": "#/$defs/ThermalStatus"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_mono_ms",
            "kind"
          ],
          "properties": {
            "at_mono_ms": {
              "$ref": "common.schema.json#/$defs/MonoMs"
            },
            "kind": {
              "const": "low_memory"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_mono_ms",
            "kind",
            "reason"
          ],
          "properties": {
            "at_mono_ms": {
              "$ref": "common.schema.json#/$defs/MonoMs"
            },
            "kind": {
              "const": "inference_down"
            },
            "reason": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_mono_ms",
            "kind",
            "tier"
          ],
          "properties": {
            "at_mono_ms": {
              "$ref": "common.schema.json#/$defs/MonoMs"
            },
            "kind": {
              "const": "inference_up"
            },
            "tier": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_mono_ms",
            "kind"
          ],
          "properties": {
            "at_mono_ms": {
              "$ref": "common.schema.json#/$defs/MonoMs"
            },
            "kind": {
              "const": "audio_focus_lost"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_mono_ms",
            "kind",
            "active"
          ],
          "properties": {
            "at_mono_ms": {
              "$ref": "common.schema.json#/$defs/MonoMs"
            },
            "kind": {
              "const": "call_state"
            },
            "active": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_mono_ms",
            "kind",
            "req_id",
            "route_key",
            "graph_version",
            "outcome",
            "engine_ms"
          ],
          "properties": {
            "at_mono_ms": {
              "$ref": "common.schema.json#/$defs/MonoMs"
            },
            "kind": {
              "const": "search_finished"
            },
            "req_id": {
              "type": "string"
            },
            "route_key": {
              "$ref": "common.schema.json#/$defs/RouteKey"
            },
            "graph_version": {
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/SearchOutcome"
            },
            "facts_ref": {
              "type": "string"
            },
            "engine_ms": {
              "type": "integer",
              "minimum": 0,
              "description": "Wall time of the Valhalla call (measurement only)."
            }
          },
          "description": "The single terminal event: exactly one per started search. There is no timeout outcome (03 §3.1)."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_mono_ms",
            "kind"
          ],
          "properties": {
            "at_mono_ms": {
              "$ref": "common.schema.json#/$defs/MonoMs"
            },
            "kind": {
              "const": "engine_reset"
            }
          },
          "description": "Valhalla actor re-created. Does not by itself resume searching."
        }
      ]
    },
    "ThermalStatus": {
      "description": "Android THERMAL_STATUS_* (7 levels).",
      "enum": [
        "none",
        "light",
        "moderate",
        "severe",
        "critical",
        "emergency",
        "shutdown"
      ]
    },
    "SearchOutcome": {
      "enum": [
        "ok",
        "cancelled",
        "error"
      ]
    },
    "SearchPriority": {
      "description": "Single priority queue, highest first: reroute > explicit_plan > avoid_chip > comparison (03 §3.1).",
      "enum": [
        "reroute",
        "explicit_plan",
        "avoid_chip",
        "comparison"
      ]
    },
    "DistanceClass": {
      "description": "Distance class the Planner fixes before searching, for every candidate search of the same plan: pre-search ETA estimate < 1800 s -> short; >= 1800 s or no estimate -> long; selects the comparison budget (3 s / 8 s from the plan start) and the watchdog limit (5 s / 10 s from each start) (03 §3.1, 07 §1). Searches outside a plan (reroute / avoid_chip) fix it at their start from the valid remaining ETA on the current route (< 1800 s -> short; >= 1800 s, unknown or invalidated -> long; the plan's class is not inherited) and use it for the watchdog limit only (team decision 2026-11-25).",
      "enum": [
        "short",
        "long"
      ]
    },
    "RankReason": {
      "description": "Why rank was emitted: all_done = every candidate search returned; budget_expired = the comparison budget (short 3 s / long 8 s from the plan start, 03 §3.1 item 3) passed first.",
      "enum": [
        "all_done",
        "budget_expired"
      ]
    },
    "TickOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voice_cmds",
        "ui_cmds",
        "planner_cmds",
        "next_wake_mono_ms",
        "log"
      ],
      "properties": {
        "horizon": {
          "$ref": "maneuver-horizon.schema.json",
          "description": "Only present when frame_seq changed (04 §2)."
        },
        "voice_cmds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VoiceCmd"
          }
        },
        "ui_cmds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UiCmd"
          }
        },
        "planner_cmds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlannerCmd"
          }
        },
        "next_wake_mono_ms": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/MonoMs"
            },
            {
              "type": "null"
            }
          ],
          "description": "Earliest mono time the output may change without new input (watchdog deadline, comparison budget). null = nothing to wait for. ADR-0008 decision 3."
        },
        "log": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LogEvent"
          }
        }
      }
    },
    "PlannerCmd": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cmd",
            "req_id",
            "priority",
            "distance_class",
            "route_key",
            "graph_version"
          ],
          "properties": {
            "cmd": {
              "const": "start"
            },
            "req_id": {
              "type": "string"
            },
            "priority": {
              "$ref": "#/$defs/SearchPriority"
            },
            "distance_class": {
              "$ref": "#/$defs/DistanceClass"
            },
            "route_key": {
              "$ref": "common.schema.json#/$defs/RouteKey"
            },
            "graph_version": {
              "type": "string"
            },
            "candidate_id": {
              "type": "string",
              "description": "CandidateRequest of the current plan to run (Session::plan_candidates output). Absent for searches outside a plan. Team decision 2026-11-25, not in docs yet."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cmd",
            "req_id"
          ],
          "properties": {
            "cmd": {
              "const": "cancel"
            },
            "req_id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cmd",
            "plan_request_id",
            "facts_refs",
            "reason"
          ],
          "description": "Kotlin calls dc_rank with the CandidateFacts behind facts_refs (facts_ref of each candidate search that returned ok, in request order; may be empty). Exactly one per plan; the plan is over afterwards (its late search_finished only frees the slot as discarded_late). Team decision 2026-11-25, not in docs yet.",
          "properties": {
            "cmd": {
              "const": "rank"
            },
            "plan_request_id": {
              "type": "string"
            },
            "facts_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reason": {
              "$ref": "#/$defs/RankReason"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cmd",
            "req_id",
            "route_key"
          ],
          "description": "Kotlin calls dc_route_commit with the route body of search req_id. Only for a reroute / explicit_plan search outside a plan that returned ok with a valid state (not cancelled / engine_stuck, route_key equal to the current route); never for avoid_chip (dc_avoid_offer_eval + consent) nor for a plan candidate (rank). route_key is the current route's key when the search started (not the new route's); dc_route_commit re-checks it and returns E_STALE without replacing anything if the route changed meanwhile. Team decision 2026-11-25, not in docs yet.",
          "properties": {
            "cmd": {
              "const": "commit"
            },
            "req_id": {
              "type": "string"
            },
            "route_key": {
              "$ref": "common.schema.json#/$defs/RouteKey"
            }
          }
        }
      ]
    },
    "UiCmd": {
      "description": "Only what docs v1.2 names. Display state already in ManeuverHorizon (3-ahead cards, HorizonEntry.avoid_offer) is not repeated here: TickOutput.horizon is the single source (04 §1). TODO(schema-v1): further items are listed in core-rust/README.md.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ui"
          ],
          "properties": {
            "ui": {
              "const": "show_checking_route"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ui",
            "confirm_screen_id",
            "override_id",
            "expires_at_mono_ms"
          ],
          "description": "Present a validated override on the confirm screen Kotlin opened, only while route_key matches and the screen is valid (05 §3.2). Confirmation itself only comes from dict yes / user_tap (ADR-0007). expires_at_mono_ms = Applied.expires_at_mono_ms (03 §4.2: <= 30 s).",
          "properties": {
            "ui": {
              "const": "show_confirm"
            },
            "confirm_screen_id": {
              "type": "string"
            },
            "override_id": {
              "type": "string"
            },
            "expires_at_mono_ms": {
              "$ref": "common.schema.json#/$defs/MonoMs"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ui",
            "target_id",
            "reason"
          ],
          "description": "Remove a shown item now. target_id uses the user_tap namespace: AvoidOffer.offer_id | override_id | confirm_screen_id (ADR-0008).",
          "properties": {
            "ui": {
              "const": "dismiss"
            },
            "target_id": {
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/DismissReason"
            }
          }
        }
      ]
    },
    "DismissReason": {
      "description": "expired = deadline passed (04 §4.3, 05 §3.2); cancelled = 取消 / CXL; route_changed = route updated meanwhile (05 §3.2); superseded = replaced by a newer proposal, consent never carries over (ADR-0007).",
      "enum": [
        "expired",
        "cancelled",
        "route_changed",
        "superseded"
      ]
    },
    "VoiceCmd": {
      "description": "Instruction to Kotlin's single TTS queue (05 §5). No text: Kotlin renders template_id + numeric params with the same template as the screen (04 §2, ADR-0007 decision 8).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "voice",
            "token",
            "priority",
            "template_id",
            "params"
          ],
          "properties": {
            "voice": {
              "const": "speak"
            },
            "token": {
              "type": "string",
              "description": "Opaque utterance_token {route_key, event_id, generation} (05 §5); tts_* events echo it. TODO(schema-v1): encoding."
            },
            "priority": {
              "$ref": "#/$defs/VoicePriority"
            },
            "template_id": {
              "type": "string"
            },
            "params": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "voice",
            "token"
          ],
          "description": "Silence now; Kotlin must not wait for onStop before the next P1 (05 §5).",
          "properties": {
            "voice": {
              "const": "stop"
            },
            "token": {
              "type": "string"
            }
          }
        }
      ]
    },
    "VoicePriority": {
      "description": "P0 > P1 > P2 > P3, highest first (05 §5).",
      "enum": [
        "p0",
        "p1",
        "p2",
        "p3"
      ]
    },
    "LogEvent": {
      "description": "Structured, privacy-safe log (no raw utterance text).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at_mono_ms",
        "what"
      ],
      "properties": {
        "at_mono_ms": {
          "$ref": "common.schema.json#/$defs/MonoMs"
        },
        "what": {
          "type": "string"
        },
        "req_id": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
