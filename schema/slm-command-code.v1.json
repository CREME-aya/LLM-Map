{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slmorllm.local/schema/slm-command-code.v1.json",
  "title": "Driving SLM 1-Line Fixed Command Code Specification (v1)",
  "description": "Single source of truth for the Phase 1 in-driving 0.5B SLM 1-line fixed command codes, OVR parameter mappings to PersonalRoutingOverride, deterministic pre-filter phrases, and Safety Gate invariants.",
  "schema_version": 1,
  "grammar_path": "android/native/inference/grammars/driving_command_v1.gbnf",
  "runtime_budget": {
    "target_model": "Qwen2.5-0.5B-Instruct-Q4_K_M",
    "max_grammar_tokens_target": 15,
    "hard_output_token_limit": 32,
    "inference_timeout_ms": 2500,
    "max_utterance_chars": 120,
    "line_terminator": "\n"
  },
  "safety_invariants": {
    "ovr_auto_reroute_allowed": false,
    "ovr_requires_explicit_consent": true,
    "offer_expiry_seconds": 30,
    "avoid_chip_deadline_before_maneuver_seconds": 20,
    "undo_window_seconds": 5,
    "max_detour_ratio_clamp": 1.35,
    "allow_through_ref_while_driving": false,
    "allow_hard_constraint_escalation": false,
    "treat_slm_output_as_untrusted": true
  },
  "input_context_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "pending_offer",
      "last_junction",
      "next_junction",
      "trip_mode"
    ],
    "properties": {
      "pending_offer": {
        "type": "string",
        "enum": ["none", "avoid", "override_preview"]
      },
      "last_junction": {
        "type": "string",
        "enum": ["none", "present"]
      },
      "next_junction": {
        "type": "string",
        "enum": ["none", "present"]
      },
      "trip_mode": {
        "type": "string",
        "enum": ["off", "on"]
      }
    }
  },
  "commands": {
    "OVR": {
      "has_parameters": true,
      "min_parameters": 1,
      "max_parameters": 4,
      "unique_keys": true,
      "canonical_key_order": ["rc", "nr", "mg", "dt", "jp"],
      "description": "Propose a PersonalRoutingOverride (weights, detour tolerance, or soft junction avoidance). Must only re-score and present a confirmation preview; never auto-reroutes without explicit user consent.",
      "expansion_target": {
        "schema_version": 1,
        "action": "suggest_route_preference"
      },
      "parameters": {
        "rc": {
          "description": "Oncoming-crossing right turn avoidance priority",
          "values": {
            "L": "low",
            "N": "normal",
            "H": "high"
          },
          "target_field": "weights.crossing_right"
        },
        "nr": {
          "description": "Narrow residential road avoidance priority",
          "values": {
            "L": "low",
            "N": "normal",
            "H": "high"
          },
          "target_field": "weights.narrow_road"
        },
        "mg": {
          "description": "Short ramp / side-road merge avoidance priority",
          "values": {
            "L": "low",
            "N": "normal",
            "H": "high"
          },
          "target_field": "weights.merge"
        },
        "dt": {
          "description": "Detour time tolerance (clamped by OverrideValidator to IntentContract limits and max_detour_ratio <= 1.35)",
          "values": {
            "T": "tight",
            "S": "standard",
            "R": "relaxed"
          },
          "target_field": "detour"
        },
        "jp": {
          "description": "Recent or upcoming difficult junction soft avoidance (resolved by Rust from allowed ref table; soft avoid_if_practical only)",
          "values": {
            "last": {
              "ref_source": "last_passed_difficult_junction",
              "mode": "avoid_if_practical"
            },
            "next": {
              "ref_source": "next_upcoming_difficult_junction",
              "mode": "avoid_if_practical"
            }
          },
          "target_field": "junction_preferences"
        }
      }
    },
    "CXL": {
      "has_parameters": false,
      "description": "Cancel the pending proposal/utterance or revert a route switch applied within the 5-second undo window."
    },
    "WHY": {
      "has_parameters": false,
      "description": "Read a deterministic 1-sentence reason for the current route from Rust comparison metrics inside a safe P2 window."
    },
    "BMK": {
      "has_parameters": false,
      "description": "Bookmark the active or most recent trip-mode history item for post-drive review."
    },
    "YES": {
      "has_parameters": false,
      "description": "Explicitly accept an active, unexpired route/avoid offer. No-op if no valid offer is pending."
    },
    "NO": {
      "has_parameters": false,
      "description": "Reject an active route/avoid offer and keep the current route. No-op if no valid offer is pending."
    },
    "NOOP": {
      "has_parameters": false,
      "description": "Safe no-operation fallback for out-of-contract requests, prohibited safety/fact/chat requests, or unintelligible noise."
    }
  },
  "deterministic_prefilter": {
    "description": "Exact normalized Japanese short phrases handled deterministically before invoking the SLM (works even in Tier 0).",
    "normalization": [
      "strip_whitespace",
      "strip_trailing_punctuation"
    ],
    "exact_matches": {
      "YES": [
        "はい",
        "お願い",
        "お願いします",
        "それで",
        "回避",
        "回避して",
        "変更して"
      ],
      "NO": [
        "いいえ",
        "いらない",
        "このまま",
        "変更しない",
        "大丈夫"
      ],
      "CXL": [
        "キャンセル",
        "やめて",
        "取り消し",
        "取り消して",
        "戻して",
        "元に戻して"
      ],
      "WHY": [
        "なんでこの道",
        "どうしてこの道",
        "理由を教えて"
      ],
      "BMK": [
        "あとで詳しく",
        "後で詳しく",
        "保存して",
        "ブックマーク"
      ]
    }
  },
  "prohibited_reasons": [
    "safety_guarantee",
    "destination_change",
    "auto_reroute_without_consent",
    "direct_route_or_tbt_generation",
    "realtime_fact_or_history_hallucination",
    "long_chat_or_narration",
    "p0_p1_audio_interference",
    "phase2_poi_detour",
    "l2_hard_constraint_while_driving",
    "external_app_or_vehicle_control"
  ]
}
